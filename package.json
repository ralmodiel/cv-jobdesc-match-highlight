{
  "name": "cv-highlighter",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --port 4196 --strictPort",
    "assets": "node scripts/fetch-assets.mjs",
    "check:unit": "node scripts/check-unit.mjs",
    "check:browser": "node scripts/check-browser.mjs",
    "check:e2e": "vite build && node scripts/check-e2e.mjs",
    "check:deps": "node scripts/check-deps.mjs",
    "check": "npm run check:unit && npm run check:browser && npm run check:e2e"
  },
  "dependencies": {
    "@huggingface/transformers": "4.3.2",
    "docx": "9.15.2",
    "docx-preview": "0.4.1",
    "jszip": "3.10.1",
    "pdf-lib": "1.17.1",
    "@pdf-lib/fontkit": "1.1.1",
    "pdfjs-dist": "6.4.299",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@vitejs/plugin-react": "4.3.4",
    "axe-core": "4.14.0",
    "playwright-core": "1.64.1",
    "tailwindcss": "4.3.3",
    "vite": "6.4.5"
  }
}
